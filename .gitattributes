# 强制所有文本文件在仓库中存储为 LF，检出时也为 LF
* text=auto eol=lf

# 显式指定常见文本文件类型，防止二进制被误判
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml yaml text eol=lf
*.yaml yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf

# 禁止转换二进制文件
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary